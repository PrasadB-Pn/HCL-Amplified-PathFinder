ENVIRONMENT=production
MONGODB_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
MONGODB_DATABASE=pathfinder
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
CORS_ORIGINS=https://YOUR-APP.vercel.app,https://YOUR-CUSTOM-DOMAIN
SEMANTIC_SEARCH_ENABLED=false
